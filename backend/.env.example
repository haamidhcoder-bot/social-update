DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=social_update
SECRET_KEY=put-a-long-random-string-here
FLASK_DEBUG=0
PORT=5000

# Cloudinary (https://cloudinary.com/console) - needed for picture uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=social_update

# Google Maps JavaScript API key (optional) - enables the Google map pin picker.
# Without it the pin picker falls back to OpenStreetMap.
GOOGLE_MAPS_API_KEY=
# Set to 1 only when the site is served over HTTPS
COOKIE_SECURE=0
